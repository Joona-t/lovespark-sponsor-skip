{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.36",
  "minimum_chrome_version": "121",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "service_worker": "background-worker.js",
    "scripts": [
      "lib/browser-polyfill.min.js",
      "core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content-styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "lib/browser-polyfill.min.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mascot.png"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-skip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle sponsor skip on/off"
    },
    "whitelist-channel": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Whitelist current channel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sponsor-skip@lovespark.suite",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "default_locale": "en"
}
